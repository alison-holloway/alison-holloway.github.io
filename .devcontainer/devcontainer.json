{
  "name": "Portfolio Dev",
  "image": "mcr.microsoft.com/devcontainers/jekyll:2-3.3-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "mounts": [
    "source=portfolio-claude-config,target=/home/vscode/.claude,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [4000],
  "portsAttributes": {
    "4000": {
      "label": "Jekyll",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "pomdtr.excalidraw-editor"
      ]
    }
  },
  "remoteUser": "vscode"
}
